# Source all custom directories that might be specific per machine, user, etc.
# IMPORTANT: this must be early. If included last, below the `Host` entries,
# then it would be parsed as a conditional include that only applies if the last
# `Host` matches!
Include config.d/*.sshconfig

HashKnownHosts no

# Send application-level requests of response from the server.
ServerAliveInterval 60
# Maximum times that the client will ignore the lack of response from the
# server. IOW, after ServerAliveCountMax*ServerAliveInterval seconds it will
# disconnect.
ServerAliveCountMax 3

# For unite-ssh. Seems safe enough for the remaining use cases.
ControlMaster auto

# I no longer use this, but I used to have a more specific key for some hosts,
# and this allows to match first a key with the host in its name, then fall back
# to a key with a default name. Adjust to the name of the new types of keys.
# IdentityFile ~/.ssh/id_rsa-%h
# IdentityFile ~/.ssh/id_rsa

# Automatically add a key to the ssh-agent, when used, without `ssh-add`.
AddKeysToAgent yes

# The only key in use these days.
IdentityFile ~/.ssh/id_ed25519

Host *.debian.org
	User suy-guest

Host svn.kde.org
	User suy

Host shell.sourceforge.net
	User suy

Host *.badopi.com
	User alex

Host *.badopi.org
	User alex

Host codereview.qt-project.org
	Port 29418
	User suy

